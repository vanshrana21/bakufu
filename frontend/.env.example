# --- Backend API -----------------------------------------------------------
# UNSET/blank  -> fixture mode. Every surface renders demonstration data and is
#                 labelled "Demonstration fixtures - no API configured".
# SET          -> live mode. A failed request shows an error; nothing silently
#                 falls back to a fixture.
# Uncomment once the FastAPI backend is running (uvicorn src.api.main:app):
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# --- API key (required in live mode; the backend rejects keyless calls) ----
# Server-only: there is no NEXT_PUBLIC_ prefix, so Next.js never sends it to the
# browser. Server Components send it to the API directly; the browser calls this
# app's /api/backend route, which adds it before forwarding. Restart after changes.
# BAKUFU_API_KEY=            # must equal API_KEY in backend/.env

# --- Public proxy ----------------------------------------------------------
# /api/backend is reachable without credentials by design: the browser has none
# to send. It rate limits per caller, but a caller can forge X-Forwarded-For, so
# those headers are ignored unless a reverse proxy in front of this app strips
# and rewrites them. Set this only when one does; otherwise every caller shares
# one budget, which is strict rather than forgeable.
# PROXY_TRUST_FORWARDED_FOR=true

# --- Mapbox ----------------------------------------------------------------
# Without a token the Explorer uses the MapLibre renderer, which draws the same
# layers on an open basemap. The app stays fully usable; only the satellite
# imagery is missing. Paste a public (pk.*) token to enable it.
NEXT_PUBLIC_MAPBOX_TOKEN=
