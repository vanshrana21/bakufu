# Required for endpoints that read from Supabase:
#   /shortfall/risk (needs rainfall from imd_rainfall_daily)
#   /priors, /boreholes, /foreign (direct table reads)
#
# Not required for /forecast, /production/history, /mines,
# /prospectivity/heatmap (all read from local parquet/pickle).

# Copy to .env at the repo root and fill in real values.
# .env is gitignored - never commit it.

# Supabase / Postgres connection.
#
# The API starts fine without this: all six startup artifacts load from disk
# and the forecast, mines, production-history and heatmap endpoints work.
#
# It IS needed for:
#   - /priors, /boreholes, /foreign      (read reference tables directly)
#   - /shortfall/risk                    (reads IMD rainfall for the features)
#   - the 2 DB-backed tests, which skip without it
#
# Without it /shortfall/risk returns 500 and /dashboard/summary degrades to
# {"shortfall": null, "degraded": ["shortfall"]} rather than failing outright.
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@HOST:5432/postgres

# Supabase project credentials, if you use the client rather than raw SQL.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=your-anon-or-service-key

# Shared API key. REQUIRED: the API refuses to start without it, and every
# route - the health check included - answers 401 without it in the X-API-Key
# header. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set the same value as BAKUFU_API_KEY in frontend/.env.local.
API_KEY=

# Broker for the Celery worker that runs POST /train. Without a reachable
# broker that endpoint answers 503; every other endpoint is unaffected.
#   celery -A src.worker.celery_app worker --queues training --concurrency 1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Whether a finished training job may point serving at its own artifact.
# DEFAULT: true. Activation is never unconditional - the candidate must take the
# same features as the model it replaces, beat chance and the base rate, and not
# fall materially below what is serving. A candidate that fails those checks is
# still published, and the job says why it was not activated.
# Set this to false to require `python -m scripts.promote_model <version>` for
# every promotion.
# TRAINING_ACTIVATE_ON_SUCCESS=true

# Training job timings. The worker renews its job's lease every heartbeat, and
# a job that stops being renewed for a whole lease is treated as dead so it
# stops blocking new runs. Defaults shown; override only if training is slower.
# TRAINING_HEARTBEAT_SECONDS=30
# TRAINING_LEASE_SECONDS=150
# TRAINING_QUEUE_TIMEOUT_SECONDS=1800
# TRAINING_SOFT_TIME_LIMIT_SECONDS=7200
# TRAINING_TIME_LIMIT_SECONDS=7500
